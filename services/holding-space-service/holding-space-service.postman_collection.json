		{
			"name": "Expression",
			"item": [
				{
					"name": "POST /shares",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Store shareId\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"shareId\", jsonData.id);",
									"});",
									"",
									"pm.test(\"No metric fields present\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.likeCount).to.be.undefined;",
									"    pm.expect(jsonData.engagement).to.be.undefined;",
									"    pm.expect(jsonData.score).to.be.undefined;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"content\": \"This is a safe space to share.\",\n  \"visibility\": \"public\",\n  \"anonymous\": false,\n  \"sensitivityTags\": [\"anxiety\"]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/v1/shares",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v1",
								"shares"
							]
						}
					},
					"response": []
				},
				{
					"name": "GET /shares",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"No metric fields present\", function () {",
									"    const jsonData = pm.response.json();",
									"    if (Array.isArray(jsonData)) {",
									"        jsonData.forEach(item => {",
									"            pm.expect(item.likeCount).to.be.undefined;",
									"            pm.expect(item.engagement).to.be.undefined;",
									"            pm.expect(item.score).to.be.undefined;",
									"        });",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
